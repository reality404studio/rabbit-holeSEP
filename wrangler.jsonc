{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rabbit-hole-sep",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-02",
  // OpenNext 는 Node 내장 모듈을 쓰므로 이 플래그가 필수다
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // ── 상태 저장소 ────────────────────────────────────────────────────
  // Cloudflare 에는 쓰기 가능한 파일시스템이 없다. 하루 한도 카운터와
  // 도록 보관소가 둘 다 여기로 간다 (src/lib/kv.ts).
  //
  //   1) wrangler kv namespace create RABBITHOLE_KV
  //   2) 출력된 id 를 아래 "id" 에 붙여넣는다
  //
  // 대시보드에서 만들었다면 Workers & Pages → KV 에서 id 를 복사한다.
  "kv_namespaces": [
    {
      "binding": "RABBITHOLE_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]

  // ── 시크릿 ─────────────────────────────────────────────────────────
  // ANTHROPIC_API_KEY 는 여기 적지 않는다. 이 파일은 리포에 커밋된다.
  //   wrangler secret put ANTHROPIC_API_KEY
  // 또는 대시보드 → Workers & Pages → 설정 → Variables and Secrets 에서
  // Secret 타입으로 추가한다. 서버에만 있고 브라우저로는 가지 않는다.
}
